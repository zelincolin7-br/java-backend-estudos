{
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.import.maven.enabled": true,
  "java.debug.settings.forceBuildBeforeLaunch": true,
  "java.debug.settings.console": "integratedTerminal",
  "code-runner.runInTerminal": true,
  "code-runner.executorMap": {
    "java": "export JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64 && mvn -DskipTests spring-boot:run"
  },
  "code-runner.languageSelector": [
    "javascript",
    "python",
    "typescript"
  ],
  "java.test.editor.enableShortcuts": true,
  "editor.codeLens": true,
  "testing.gutterEnabled": true,
  "java.jdt.ls.java.home": "/usr/lib/jvm/java-21-openjdk-amd64",
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-21",
      "path": "/usr/lib/jvm/java-21-openjdk-amd64",
      "default": true
    }
  ],
  "java.compile.nullAnalysis.mode": "disabled",
  "python.testing.pytestEnabled": false,
  "python.testing.unittestEnabled": false,
  "python.testing.autoTestDiscoverOnSaveEnabled": false
}
