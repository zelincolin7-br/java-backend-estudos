{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "OrderPlatformApplication",
            "request": "launch",
            "mainClass": "com.estudos.orderplatform.OrderPlatformApplication",
            "projectName": "order-platform",
            "cwd": "${workspaceFolder}/order-platform",
            "console": "integratedTerminal",
            "shortenCommandLine": "argfile",
            "vmArgs": "-javaagent:${workspaceFolder}/order-platform/newrelic/newrelic.jar -Dnewrelic.config.file=${workspaceFolder}/order-platform/newrelic/newrelic.yml -Dnewrelic.environment=development"
        },
        {
            "type": "java",
            "name": "LambdaExamples",
            "request": "launch",
            "mainClass": "com.estudos.orderplatform.javalabs.week1.day1.LambdaExamples",
            "projectName": "order-platform",
            "console": "integratedTerminal",
            "shortenCommandLine": "argfile"
        }
    ]
}
