{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "OrderPlatformApplication",
            "request": "launch",
            "mainClass": "com.estudos.orderplatform.OrderPlatformApplication",
            "projectName": "order-platform",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "shortenCommandLine": "argfile",
            "vmArgs": "-javaagent:${workspaceFolder}/newrelic/newrelic.jar -Dnewrelic.config.file=${workspaceFolder}/newrelic/newrelic.yml -Dnewrelic.environment=development"
        },
        {
            "type": "java",
            "name": "Order Platform com New Relic",
            "request": "launch",
            "mainClass": "com.estudos.orderplatform.OrderPlatformApplication",
            "projectName": "order-platform",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "shortenCommandLine": "argfile",
            "vmArgs": "-javaagent:${workspaceFolder}/newrelic/newrelic.jar -Dnewrelic.config.file=${workspaceFolder}/newrelic/newrelic.yml -Dnewrelic.environment=development"
        }
    ]
}
